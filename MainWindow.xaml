<Window x:Class="AIUsageMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AIUsageMonitor.UI"
        Title="AI 사용량 모니터"
        SizeToContent="Manual"
        WindowStyle="SingleBorderWindow" Background="#1B1C21"
        ResizeMode="NoResize" ShowInTaskbar="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic" FontSize="12.5"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        d:DataContext="{d:DesignInstance ui:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="WinBg" Color="#1B1C21"/>
        <SolidColorBrush x:Key="CardBg" Color="#24262C"/>
        <SolidColorBrush x:Key="Line" Color="#33363E"/>
        <SolidColorBrush x:Key="Track" Color="#363941"/>
        <SolidColorBrush x:Key="Fg" Color="#E8E8EA"/>
        <SolidColorBrush x:Key="Fg2" Color="#9A9DA6"/>
        <SolidColorBrush x:Key="Hover" Color="#2EFFFFFF"/>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Fg2}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#33D97757" CornerRadius="6" Padding="10,5">
                            <ContentPresenter TextElement.Foreground="#F0B8A2" TextElement.FontWeight="SemiBold"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#55D97757"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 세션 줄: 열 수 있는 세션이면 마우스를 올렸을 때 살짝 밝아지고 손가락 커서 -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="5" Margin="-4,0,-4,0" Padding="4,0,4,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="b" Property="Background" Value="#14FFFFFF"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 어두운 테마용 얇은 스크롤바 -->
        <Style x:Key="ThinThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="t" Background="#3DFFFFFF" CornerRadius="2.5"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="t" Property="Background" Value="#66FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/>
            <Setter Property="MinWidth" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ThinThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="CardTemplate" DataType="{x:Type ui:ProviderCard}">
            <Border Background="{StaticResource CardBg}" CornerRadius="10" Padding="14,12,14,10" Width="390" Height="384">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="9" Height="9" Fill="{Binding Accent}" VerticalAlignment="Center" Margin="0,1,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Fg}"/>
                        <Border Grid.Column="2" Visibility="{Binding PlanVisibility}" Background="#1FFFFFFF" CornerRadius="4"
                                Padding="6,1" Margin="8,1,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Plan}" FontSize="11" Foreground="{StaticResource Fg}"/>
                        </Border>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{Binding AppStatusBrush}" Margin="0,1,6,0"/>
                            <TextBlock Text="{Binding AppStatus}" Foreground="{StaticResource Fg2}" FontSize="11.5"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ItemsControl ItemsSource="{Binding AccountSlots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type ui:AccountUsageSlot}">
                                    <Border Height="102" ToolTip="{Binding ToolTipText}" Background="Transparent" CornerRadius="6"
                                            AllowDrop="True" PreviewMouseLeftButtonDown="Account_MouseDown" PreviewMouseMove="Account_MouseMove"
                                            DragOver="Account_DragOver" DragLeave="Account_DragLeave" Drop="Account_Drop">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanDrag}" Value="True">
                                                        <Setter Property="Cursor" Value="SizeAll"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Visibility="{Binding ContentVisibility}">
                                            <TextBlock Text="{Binding Account}" Foreground="{StaticResource Fg}" FontSize="11"
                                                       TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                                            <Grid Width="54" Height="54" HorizontalAlignment="Center"
                                                  AutomationProperties.Name="{Binding ToolTipText}">
                                                <ui:UsageRing Remaining="{Binding Remaining}" Visibility="{Binding RingVisibility}"/>
                                                <TextBlock Text="{Binding RemainingText}" Foreground="{Binding LevelBrush}"
                                                           FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Text="{Binding ResetTimer}" Foreground="{StaticResource Fg2}" FontSize="10"
                                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding Label}" Foreground="{Binding LevelBrush}" FontSize="10"
                                                       HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Margin="12,0,0,0" Padding="12,0,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Notice}" ToolTip="{Binding Notice}" Visibility="{Binding NoticeVisibility}"
                                       Foreground="{Binding NoticeBrush}" FontSize="10.5" Margin="0,0,0,6" TextWrapping="Wrap" MaxHeight="44"/>
                            <Button DockPanel.Dock="Top" Style="{StaticResource LinkButton}" Visibility="{Binding ActionVisibility}"
                                    Command="{Binding ActionCommand}" HorizontalAlignment="Left" Margin="0,0,0,6" FontSize="10.5">
                                <TextBlock Text="{Binding ActionText}"/>
                            </Button>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding SessionsHeader}" Foreground="{StaticResource Fg2}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding SessionsEmpty}" Visibility="{Binding SessionsEmptyVisibility}"
                                       Foreground="{StaticResource Fg2}" FontSize="11.5" Margin="0,6,0,0"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-8,0" Padding="0,0,8,0">
                            <ItemsControl ItemsSource="{Binding Sessions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ui:SessionRow}">
                                        <Button Style="{StaticResource RowButton}" Command="{Binding OpenCommand}" ToolTip="{Binding ToolTipText}"
                                                AutomationProperties.Name="{Binding Title}">
                                        <Grid Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" VerticalAlignment="Top" Margin="0,6,0,0" HorizontalAlignment="Left"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource Fg}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Fg2}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding StateText}" Foreground="{Binding StateBrush}"
                                                       FontSize="11.5" FontWeight="SemiBold" Margin="10,1,0,0"/>
                                        </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="{Binding Footnote}" Foreground="#6E717B" FontSize="10" Margin="0,5,0,0"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Footnote}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{StaticResource WinBg}">
        <DockPanel>
            <!-- 타이틀 바 -->
            <Grid DockPanel.Dock="Top" Height="40" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="AI 사용량 모니터" Foreground="{StaticResource Fg}" FontWeight="SemiBold" FontSize="13"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                    <Button Style="{StaticResource IconButton}" Content="계정" FontFamily="Segoe UI, Malgun Gothic" Width="42"
                            ToolTip="계정 추가 및 사용량 보기" Click="Accounts_Click"/>
                    <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="지금 새로고침" Click="Refresh_Click"/>
                    <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#xE718;" ToolTip="항상 위에 표시" Click="Pin_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="트레이로 숨기기" Click="Hide_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="닫기 (트레이에서 계속 실행)" Click="Hide_Click"/>
                </StackPanel>
            </Grid>

            <!-- 창 크기는 고정: 카드(왼쪽) + 캐릭터(오른쪽) 두 줄 -->
            <StackPanel Margin="10,0,10,0">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentControl Content="{Binding Claude}" ContentTemplate="{StaticResource CardTemplate}" Width="390" Height="384"/>
                    <ui:CharacterStage x:Name="ClaudeStage" Grid.Column="1" Character="claude" Width="140" Height="280"
                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentControl Content="{Binding Codex}" ContentTemplate="{StaticResource CardTemplate}" Width="390" Height="384"/>
                    <ui:CharacterStage x:Name="CodexStage" Grid.Column="1" Character="codex" Width="140" Height="280"
                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
