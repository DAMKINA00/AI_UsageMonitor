<Window x:Class="AIUsageMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AIUsageMonitor.UI"
        Title="AI 사용량 모니터"
        SizeToContent="Manual"
        WindowStyle="SingleBorderWindow" Background="#1B1C21"
        ResizeMode="CanResize" ShowInTaskbar="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic" FontSize="11"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        d:DataContext="{d:DesignInstance ui:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="WinBg" Color="#1B1C21"/>
        <SolidColorBrush x:Key="CardBg" Color="#24262C"/>
        <SolidColorBrush x:Key="Line" Color="#33363E"/>
        <SolidColorBrush x:Key="Track" Color="#363941"/>
        <SolidColorBrush x:Key="Fg" Color="#E8E8EA"/>
        <SolidColorBrush x:Key="Fg2" Color="#9A9DA6"/>
        <SolidColorBrush x:Key="Hover" Color="#2EFFFFFF"/>
        <GridLength x:Key="AccountColumnWidth">2*</GridLength>
        <GridLength x:Key="SessionColumnWidth">3*</GridLength>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Fg2}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#33D97757" CornerRadius="5" Padding="7,1">
                            <ContentPresenter TextElement.Foreground="#F0B8A2" TextElement.FontWeight="SemiBold"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#55D97757"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 세션 줄: 열 수 있는 세션이면 마우스를 올렸을 때 살짝 밝아지고 손가락 커서 -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="4" Margin="-3,0,-3,0" Padding="3,0,3,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="b" Property="Background" Value="#14FFFFFF"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 어두운 테마용 얇은 스크롤바 -->
        <Style x:Key="ThinThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="t" Background="#3DFFFFFF" CornerRadius="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="t" Property="Background" Value="#66FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="MinWidth" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ThinThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 계정 세 칸은 세로 정렬 후 받은 공간에 비례해 확대한다. -->
        <DataTemplate x:Key="CardTemplate" DataType="{x:Type ui:ProviderCard}">
            <Border Background="{StaticResource CardBg}" CornerRadius="8" Padding="10,7,6,6" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{DynamicResource AccountColumnWidth}"/>
                        <ColumnDefinition Width="{DynamicResource SessionColumnWidth}"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 헤더: 이름 · 요금제 · 앱 상태 · 데이터 상태 칩 -->
                    <DockPanel Grid.ColumnSpan="2" Height="20" Margin="0,0,4,0">
                        <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{Binding Accent}" VerticalAlignment="Center" Margin="0,1,7,0"/>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Fg}"
                                   VerticalAlignment="Center"/>
                        <Border DockPanel.Dock="Left" Visibility="{Binding PlanVisibility}" Background="#1FFFFFFF" CornerRadius="4"
                                Padding="5,0" Margin="7,1,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Plan}" FontSize="10" Foreground="{StaticResource Fg}"/>
                        </Border>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Status.Text}" Foreground="{Binding Status.Brush}" FontSize="10"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,1,0,0"
                                   ToolTip="{Binding Status.ToolTipText}" AutomationProperties.Name="{Binding Status.Text}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Visibility="{DynamicResource AppStatusVisibility}">
                            <Ellipse Width="6" Height="6" Fill="{Binding AppStatusBrush}" Margin="0,1,5,0"/>
                            <TextBlock Text="{Binding AppStatus}" Foreground="{StaticResource Fg2}" FontSize="10"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- 안내 한 줄 (있을 때만): 오류·경고 문구와 로그인 버튼 -->
                    <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Visibility="{Binding NoticeRowVisibility}" Margin="0,1,4,2">
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Visibility="{Binding ActionVisibility}"
                                Command="{Binding ActionCommand}" FontSize="10" Margin="6,0,0,0"
                                AutomationProperties.Name="{Binding ActionText}">
                            <TextBlock Text="{Binding ActionText}"/>
                        </Button>
                        <TextBlock Text="{Binding Notice}" ToolTip="{Binding Notice}" Foreground="{Binding NoticeBrush}" FontSize="10"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Viewbox x:Name="AccountScale" Grid.Row="2" Stretch="Uniform" Margin="4,3,12,2"
                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SizeChanged="AccountScale_SizeChanged">
                    <ItemsControl ItemsSource="{Binding AccountSlots}" Width="168" Height="126">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="3" Columns="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:AccountUsageSlot}">
                                <Border ToolTip="{Binding ToolTipText}" Background="Transparent" CornerRadius="6" Margin="0,3"
                                        AllowDrop="True" PreviewMouseLeftButtonDown="Account_MouseDown" PreviewMouseMove="Account_MouseMove"
                                        DragOver="Account_DragOver" DragLeave="Account_DragLeave" Drop="Account_Drop">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanDrag}" Value="True">
                                                    <Setter Property="Cursor" Value="SizeAll"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Visibility="{Binding ContentVisibility}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="34" Height="34" HorizontalAlignment="Left"
                                              Opacity="{Binding UsageOpacity}"
                                              AutomationProperties.Name="{Binding ToolTipText}">
                                            <ui:UsageRing Remaining="{Binding Remaining}" Visibility="{Binding RingVisibility}"/>
                                            <TextBlock Text="{Binding RemainingText}" Foreground="{Binding LevelBrush}"
                                                       FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="⚠" Foreground="#E5A54B" FontSize="10"
                                                       Margin="2,0,0,0" Visibility="{Binding WarningVisibility}"
                                                       AutomationProperties.Name="사용량 조회 실패 또는 오래된 값"/>
                                            <TextBlock Text="{Binding Account}" Foreground="{StaticResource Fg}" FontSize="12" FontWeight="Bold"
                                                       LineHeight="13" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding ShortLabel}" Foreground="{Binding LevelBrush}" FontSize="10"
                                                   LineHeight="11" LineStackingStrategy="BlockLineHeight"/>
                                        <TextBlock Text="{Binding ResetTimer}" Foreground="{StaticResource Fg2}" FontSize="10"
                                                   LineHeight="11" LineStackingStrategy="BlockLineHeight"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </Viewbox>

                    <!-- 세션 목록: 한 줄에 제목과 상태. 부제·경과 시간은 툴팁 -->
                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="10,0,0,0" Margin="0,2,4,0"
                            Visibility="{DynamicResource SessionListVisibility}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding SessionsHeader}" Foreground="{StaticResource Fg2}" FontSize="10" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <Border DockPanel.Dock="Top" Visibility="{DynamicResource SessionListVisibility}">
                                <TextBlock Text="{Binding SessionsEmpty}" Visibility="{Binding SessionsEmptyVisibility}"
                                           Foreground="{StaticResource Fg2}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </Border>
                            <ScrollViewer Visibility="{DynamicResource SessionListVisibility}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,1,-6,0" Padding="0,0,6,0">
                                <ItemsControl ItemsSource="{Binding Sessions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ui:SessionRow}">
                                            <Button Style="{StaticResource RowButton}" Command="{Binding OpenCommand}" ToolTip="{Binding ToolTipText}"
                                                    AutomationProperties.Name="{Binding ToolTipText}">
                                                <Grid Height="17">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="11"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="6" Height="6" Fill="{Binding StateBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{StaticResource Fg}" FontSize="11"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding StateText}" Foreground="{Binding StateBrush}"
                                                               FontSize="10" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{StaticResource WinBg}">
        <DockPanel x:Name="Dashboard">
            <!-- 타이틀 바 -->
            <Grid DockPanel.Dock="Top" Height="34" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="AI 사용량 모니터" Foreground="{StaticResource Fg}" FontWeight="SemiBold" FontSize="13"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                    <Button x:Name="AccountsButton" Style="{StaticResource IconButton}" Content="계정" FontFamily="Segoe UI, Malgun Gothic" Width="40"
                            ToolTip="계정 패널 열기/닫기" AutomationProperties.Name="계정 패널 열기/닫기" Click="Accounts_Click"/>
                    <Button x:Name="SessionsButton" Style="{StaticResource IconButton}" Content="&#xE8FD;" ToolTip="세션 목록 표시/숨기기"
                            AutomationProperties.Name="세션 목록 표시/숨기기" Click="Sessions_Click"/>
                    <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="지금 새로고침"
                            AutomationProperties.Name="지금 새로고침" Click="Refresh_Click"/>
                    <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#xE718;" ToolTip="항상 위에 표시"
                            AutomationProperties.Name="항상 위에 표시" Click="Pin_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="트레이로 숨기기"
                            AutomationProperties.Name="트레이로 숨기기" Click="Hide_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="닫기 (트레이에서 계속 실행)"
                            AutomationProperties.Name="닫기 (트레이에서 계속 실행)" Click="Hide_Click"/>
                </StackPanel>
            </Grid>

            <!-- 캐릭터는 세션 오른쪽 아래의 오버레이이며 계정 영역 폭을 차지하지 않는다. -->
            <Grid x:Name="Rows" Margin="8,0,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="132"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="*" MinHeight="132"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="*" MinHeight="132"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <ContentControl Content="{Binding Claude}" ContentTemplate="{StaticResource CardTemplate}"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                    <ui:CharacterStage x:Name="ClaudeStage" Character="claude" BubblePlacement="Left" FigureHeight="150"
                                       Width="224" MaxHeight="150" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,3,6,6"
                                       Panel.ZIndex="1" IsHitTestVisible="False"/>
                </Grid>
                <Grid Grid.Row="2">
                    <ContentControl Content="{Binding Codex}" ContentTemplate="{StaticResource CardTemplate}"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                    <ui:CharacterStage x:Name="CodexStage" Character="codex" BubblePlacement="Left" FigureHeight="150"
                                       Width="224" MaxHeight="150" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,3,6,6"
                                       Panel.ZIndex="1" IsHitTestVisible="False"/>
                </Grid>
                <Grid Grid.Row="4">
                    <ContentControl Content="{Binding Gemini}" ContentTemplate="{StaticResource CardTemplate}"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                    <ui:CharacterStage x:Name="GeminiStage" Character="gemini" BubblePlacement="Left" FigureHeight="150"
                                       Width="224" MaxHeight="150" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,3,6,6"
                                       Panel.ZIndex="1" IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>
