<Window x:Class="AIUsageMonitor.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:AIUsageMonitor.UI" Title="AI 사용량 모니터" WindowStyle="None" AllowsTransparency="True"
 Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" FontFamily="Segoe UI, Malgun Gothic" FontSize="11"
 UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources>
  <DataTemplate DataType="{x:Type ui:AccountUsageSlot}" x:Key="PlatformTemplate">
   <Border Width="144" Height="100" Margin="1,0" Background="#F222252D" CornerRadius="3,3,5,5"
    BorderBrush="#FF3B414C" BorderThickness="1,0,1,5" ToolTip="{Binding ToolTipText}">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="5"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Background="{Binding Accent}" CornerRadius="3,3,0,0"/>
     <Border Grid.Row="1" Background="Transparent" Padding="9,5" AllowDrop="True"
      MouseLeftButtonDown="Account_MouseDown" MouseMove="Account_MouseMove" DragOver="Account_DragOver" DragLeave="Account_DragLeave" Drop="Account_Drop">
      <StackPanel Opacity="{Binding UsageOpacity}">
       <DockPanel><TextBlock Text="{Binding Provider}" Foreground="{Binding Accent}" FontWeight="SemiBold" FontSize="10"/>
        <TextBlock Text="{Binding Role}" Foreground="#8E96A8" FontSize="9" TextAlignment="Right"/></DockPanel>
       <TextBlock Text="{Binding DisplayAccount}" Foreground="#E3E7F0" FontWeight="SemiBold" FontSize="10" TextTrimming="CharacterEllipsis"/>
       <DockPanel Margin="0,2,0,2"><TextBlock Text="{Binding RemainingText}" Foreground="{Binding LevelBrush}" FontSize="19" FontWeight="Bold"/>
        <TextBlock Text="{Binding ShortLabel}" Foreground="#A5ADBE" FontSize="9" TextAlignment="Right" VerticalAlignment="Center"/></DockPanel>
       <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding Remaining, Mode=OneWay}" Foreground="{Binding LevelBrush}">
        <ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Grid Background="#FF3C414B">
         <Border x:Name="PART_Track"/><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
        </Grid></ControlTemplate></ProgressBar.Template>
       </ProgressBar>
       <TextBlock Text="{Binding ResetTimer}" Foreground="#A5ADBE" FontSize="9" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
     </Border>
    </Grid>
   </Border>
  </DataTemplate>
 </Window.Resources>
 <Grid x:Name="Root" Background="{x:Null}">
  <Grid.RowDefinitions><RowDefinition Height="180"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Canvas x:Name="CharacterField" Background="{x:Null}" ClipToBounds="True" IsHitTestVisible="False">
   <ui:CharacterStage x:Name="ClaudeStage" Character="claude" Width="144" Height="178" FigureHeight="106"/>
   <ui:CharacterStage x:Name="CodexStage" Character="codex" Width="144" Height="178" FigureHeight="106"/>
   <ui:CharacterStage x:Name="GeminiStage" Character="gemini" Width="144" Height="178" FigureHeight="106"/>
   <ui:CharacterStage x:Name="GrokStage" Character="grok" Width="144" Height="178" FigureHeight="106"/>
  </Canvas>
  <ScrollViewer x:Name="PlatformScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Background="{x:Null}" CanContentScroll="False">
   <ItemsControl x:Name="PlatformItems" ItemTemplate="{StaticResource PlatformTemplate}" HorizontalAlignment="Right">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   </ItemsControl>
  </ScrollViewer>
 </Grid>
</Window>
