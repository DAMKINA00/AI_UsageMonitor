<Window x:Class="AIUsageMonitor.UI.AccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AIUsageMonitor.UI"
        Title="계정 사용량"
        Width="570" Height="700"
        MinWidth="460" MinHeight="400"
        ResizeMode="CanResize"
        Background="#1B1C21"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic"
        FontSize="12.5"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="WinBg" Color="#1B1C21"/>
        <SolidColorBrush x:Key="CardBg" Color="#24262C"/>
        <SolidColorBrush x:Key="Line" Color="#33363E"/>
        <SolidColorBrush x:Key="Track" Color="#363941"/>
        <SolidColorBrush x:Key="Fg" Color="#E8E8EA"/>
        <SolidColorBrush x:Key="Fg2" Color="#9A9DA6"/>
        <SolidColorBrush x:Key="Hover" Color="#2EFFFFFF"/>
        <SolidColorBrush x:Key="ButtonBg" Color="#2B2E36"/>
        <SolidColorBrush x:Key="ButtonBorder" Color="#444852"/>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Background" Value="{StaticResource ButtonBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ButtonBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

        <Style x:Key="UsageBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="7"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{StaticResource Track}" CornerRadius="3.5"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    CornerRadius="3.5" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" Background="#3DFFFFFF" CornerRadius="2.5"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#66FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/>
            <Setter Property="MinWidth" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ThinThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="AccountTemplate" DataType="{x:Type ui:AccountUsageCard}">
            <Border Background="{StaticResource CardBg}" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ProviderName}" Foreground="{StaticResource Fg}"
                                           FontSize="15" FontWeight="SemiBold"/>
                                <Border Background="#1FFFFFFF" CornerRadius="4" Padding="6,1" Margin="8,1,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Plan, TargetNullValue=—}" Foreground="{StaticResource Fg2}" FontSize="11"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource Fg}" FontWeight="Bold"
                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{Binding Status}" Foreground="{StaticResource Fg2}"
                                   Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Usage}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:UsageRow}">
                                <StackPanel Margin="0,0,0,10">
                                    <Grid>
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource Fg}"/>
                                        <TextBlock HorizontalAlignment="Right">
                                            <Run Text="{Binding UsedText}" Foreground="{Binding LevelBrush}" FontWeight="SemiBold"/>
                                            <Run Text="{Binding RemainText}" Foreground="{StaticResource Fg2}"/>
                                        </TextBlock>
                                    </Grid>
                                    <ProgressBar Style="{StaticResource UsageBar}" Value="{Binding Value}"
                                                 Visibility="{Binding BarVisibility}"
                                                 Foreground="{Binding LevelBrush}" Margin="0,5,0,4"/>
                                    <TextBlock Text="{Binding ResetText}" Foreground="{StaticResource Fg2}" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsSecondary, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Margin="0,2,0,0">
                        <Button Content="{Binding LoginText}" Command="{Binding LoginCommand}" IsEnabled="{Binding CanLogin}"
                                Style="{StaticResource SmallActionButton}"
                                AutomationProperties.Name="{Binding LoginText}"
                                ToolTip="브라우저에서 로그인"/>
                        <Button Content="계정 제거" Command="{Binding RemoveCommand}"
                                Style="{StaticResource SmallActionButton}"
                                IsEnabled="True"
                                AutomationProperties.Name="계정 제거 또는 로그인 취소"
                                ToolTip="로그인 대기 중이면 로그인을 취소합니다"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{StaticResource WinBg}" Padding="16,14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="계정 사용량" Foreground="{StaticResource Fg}" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button x:Name="RefreshButton" Grid.Column="1" Content="새로고침" Style="{StaticResource ActionButton}"
                        HorizontalAlignment="Right" Margin="0" Click="Refresh_Click"
                        AutomationProperties.Name="계정 사용량 새로고침"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,12,0,14">
                <TextBlock Text="브라우저에서 로그인해 계정을 추가할 수 있습니다." Foreground="{StaticResource Fg2}"
                           TextWrapping="Wrap"/>
                <TextBlock Text="기존 앱의 주 계정은 유지됩니다. Codex 로그인 시 브라우저에서 추가할 계정을 선택해 주세요." Foreground="{StaticResource Fg2}"
                           Margin="0,3,0,0" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="AddClaudeButton" Content="Claude 계정 추가" Style="{StaticResource ActionButton}"
                            Click="AddClaude_Click" AutomationProperties.Name="Claude 계정 추가"/>
                    <Button x:Name="AddCodexButton" Content="Codex 계정 추가" Style="{StaticResource ActionButton}"
                            Click="AddCodex_Click" AutomationProperties.Name="Codex 계정 추가"/>
                </StackPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="True" Padding="0,0,7,0">
                <ItemsControl x:Name="AccountItems" ItemTemplate="{StaticResource AccountTemplate}"/>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
