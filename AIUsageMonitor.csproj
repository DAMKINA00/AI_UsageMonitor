<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AIUsageMonitor</AssemblyName>
    <RootNamespace>AIUsageMonitor</RootNamespace>
    <Version>1.0.0</Version>
    <Product>AI Usage Monitor</Product>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>ko;en</SatelliteResourceLanguages>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF와 WinForms를 같이 쓰므로 이름 충돌을 피하기 위해 WinForms 전역 using은 뺀다 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <None Include="helpers\**" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\**\*.png" />
    <None Remove="art\**" />
    <Compile Remove="art\**" />
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

</Project>
